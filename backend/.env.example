# Phoenix Tender Portal - Environment Configuration
# SECURITY WARNING: Never commit this file with real secrets!
# Copy this to .env and fill in your actual values

NODE_ENV=development
PORT=5000

# MongoDB - Use environment variable or secrets manager in production
MONGO_URI=${MONGO_URI_FROM_SECRETS_MANAGER}

# JWT Secret - Generate with: crypto.randomBytes(32).toString('hex')
# Minimum 256-bit (64 hex characters) for production
JWT_SECRET=${JWT_SECRET_FROM_SECRETS_MANAGER}

# Token expiration - Short-lived access tokens
JWT_EXPIRES_IN=1h

# Refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Explicit whitelist for production
CORS_ORIGIN=https://phoenix-tender-portal.com,https://admin.phoenix-tender-portal.com

# Frontend URL
FRONTEND_URL=https://phoenix-tender-portal.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=3

# Upload Configuration
UPLOAD_PATH=./src/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg

# Logging
LOG_LEVEL=info

# Email Verification
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Account Lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MS=900000

# Session Configuration
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MS=3600000

# SMTP (Use secrets manager for credentials)
SMTP_HOST=${SMTP_HOST_FROM_SECRETS_MANAGER}
SMTP_PORT=587
SMTP_USER=${SMTP_USER_FROM_SECRETS_MANAGER}
SMTP_PASS=${SMTP_PASS_FROM_SECRETS_MANAGER}
SMTP_FROM=noreply@phoenix-tender-portal.com