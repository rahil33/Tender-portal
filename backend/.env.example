# Phoenix Tender Portal - Environment Configuration
# SECURITY WARNING: Never commit this file with real secrets!
# Copy this to .env and fill in your actual values

NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ───────────────────────────────────────────────────
# Atlas > Connect > Drivers > Node.js. The database name MUST be in the path
# (…mongodb.net/phoenix-tender-tech?…); otherwise MongoDB uses the "test" DB.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
# On Render set this in the dashboard (Environment) - no .env file is used there.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/phoenix-tender-tech?retryWrites=true&w=majority
# Optional: force the database name regardless of the URI path
# MONGO_DB_NAME=phoenix-tender-tech
# Optional tuning (defaults shown)
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_CONNECT_TIMEOUT_MS=10000
# MONGO_CONNECT_RETRIES=2
# LOCAL DEVELOPMENT ONLY, and only if "npm run db:diagnose" shows your own DNS
# server refuses SRV lookups from Node. Never set these on Render.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
# MONGO_DNS_RESULT_ORDER=ipv4first

# JWT Secret - Generate with: crypto.randomBytes(32).toString('hex')
# Minimum 256-bit (64 hex characters) for production
JWT_SECRET=${JWT_SECRET_FROM_SECRETS_MANAGER}

# Token expiration - Short-lived access tokens
JWT_EXPIRES_IN=1h

# Refresh token expiration
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Explicit whitelist for production
CORS_ORIGIN=https://phoenix-tender-portal.com,https://admin.phoenix-tender-portal.com

# Frontend URL
FRONTEND_URL=https://phoenix-tender-portal.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=3

# Upload Configuration
UPLOAD_PATH=./src/uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg

# Logging
LOG_LEVEL=info

# GeM Scraper - number of result pages (10 bids each) fetched per sync
GEM_MAX_PAGES=5

# Admin account created by: npm run seed:admin (min 10 chars; placeholders are rejected)
# NEVER use the production password here - these are safe placeholders.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
ADMIN_NAME=Administrator
ADMIN_ROLE=admin

# Email Verification
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Account Lockout
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MS=900000

# Session Configuration
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT_MS=3600000

# SMTP (Use secrets manager for credentials)
SMTP_HOST=${SMTP_HOST_FROM_SECRETS_MANAGER}
SMTP_PORT=587
SMTP_USER=${SMTP_USER_FROM_SECRETS_MANAGER}
SMTP_PASS=${SMTP_PASS_FROM_SECRETS_MANAGER}
SMTP_FROM=noreply@phoenix-tender-portal.com