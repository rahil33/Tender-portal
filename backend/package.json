{
  "name": "phoenix-tender-tech-backend",
  "version": "1.0.0",
  "description": "Phoenix Tender Tech Backend API - Modular Architecture",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "seed": "node seed.js",
    "docker:build": "docker build -t phoenix-tender-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env phoenix-tender-backend",
    "docker:dev": "docker-compose up"
  },
  "keywords": [
    "tender",
    "government-procurement",
    "portal",
    "api"
  ],
  "author": "Phoenix Tender Tech",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.4.0",
    "mongoose": "^9.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4"
  }
}
